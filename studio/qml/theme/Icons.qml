pragma Singleton
import QtQuick

QtObject {
    id: icons

    function url(name, color) {
        if (!name || name.length === 0) {
            return ""
        }
        var c = color !== undefined && color !== null ? color.toString() : "#E6EDF5"
        return "image://icon/" + name + "?color=" + encodeURIComponent(c)
    }

    // Verified Lucide icon names matching studio/resources/icons/<name>.svg
    readonly property string agent: "bot"
