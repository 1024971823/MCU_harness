<?xml version="1.0" encoding="utf-8"?>
<device schemaVersion="1.1">
  <name>STM32H563</name>
  <description>STM32H563xx Cortex-M33 mini SVD fixture for testing</description>
  <cpu>
    <name>CM33</name>
  </cpu>
  <peripherals>
    <peripheral>
      <name>GPIOA</name>
      <description>General-purpose I/Os</description>
      <groupName>GPIO</groupName>
      <baseAddress>0x42020000</baseAddress>
      <registers>
        <register>
          <name>MODER</name>
          <description>GPIO port mode register</description>
          <addressOffset>0x00</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xABFFFFFF</resetValue>
          <fields>
            <field>
              <name>MODE0</name>
              <description>Port x configuration I/O pin 0</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <name>GPIO_MODE</name>
                <enumeratedValue><name>Input</name><description>Input mode</description><value>0</value></enumeratedValue>
                <enumeratedValue><name>Output</name><description>General purpose output mode</description><value>1</value></enumeratedValue>
                <enumeratedValue><name>Alternate</name><description>Alternate function mode</description><value>2</value></enumeratedValue>
                <enumeratedValue><name>Analog</name><description>Analog mode (reset state)</description><value>3</value></enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MODE5</name>
              <description>Port x configuration I/O pin 5</description>
              <bitOffset>10</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues derivedFrom="GPIO_MODE"/>
            </field>
          </fields>
        </register>
        <register>
          <name>ODR</name>
          <description>GPIO port output data register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>OD%s</name>
              <description>Port output data pin</description>
              <dim>4</dim>
              <dimIncrement>1</dimIncrement>
              <dimIndex>0-3</dimIndex>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>OD5</name>
              <description>Port output data pin 5</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>AFR%s</name>
          <description>GPIO alternate function register</description>
          <dim>2</dim>
          <dimIncrement>0x04</dimIncrement>
          <dimIndex>L,H</dimIndex>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>AFSEL0</name>
              <description>Alternate function selection</description>
              <bitRange>[3:0]</bitRange>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <peripheral derivedFrom="GPIOA">
      <name>GPIOB</name>
      <baseAddress>0x42020400</baseAddress>
    </peripheral>

    <peripheral>
      <name>USART1</name>
      <description>Universal synchronous/asynchronous receiver transmitter</description>
      <groupName>USART</groupName>
      <baseAddress>0x40013800</baseAddress>
      <registers>
        <register>
          <name>CR1</name>
          <description>Control register 1</description>
          <addressOffset>0x00</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>UE</name>
              <description>USART enable</description>
              <bitRange>[0:0]</bitRange>
            </field>
            <field>
              <name>TE</name>
              <description>Transmitter enable</description>
              <lsb>3</lsb>
              <msb>3</msb>
            </field>
            <field>
              <name>RE</name>
              <description>Receiver enable</description>
              <lsb>2</lsb>
              <msb>2</msb>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <peripheral>
      <name>GPDMA1</name>
      <description>General purpose direct memory access controller</description>
      <baseAddress>0x40020000</baseAddress>
      <registers>
        <cluster>
          <name>C%s</name>
          <dim>2</dim>
          <dimIncrement>0x50</dimIncrement>
          <dimIndex>0-1</dimIndex>
          <addressOffset>0x50</addressOffset>
          <register>
            <name>CR</name>
            <description>Channel control register</description>
            <addressOffset>0x14</addressOffset>
            <size>32</size>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>EN</name>
                <description>Channel enable</description>
                <bitOffset>0</bitOffset>
                <bitWidth>1</bitWidth>
              </field>
            </fields>
          </register>
        </cluster>
      </registers>
    </peripheral>
  </peripherals>
</device>
